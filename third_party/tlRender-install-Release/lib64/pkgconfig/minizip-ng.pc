prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib64
sharedlibdir=${exec_prefix}/lib64
includedir=${prefix}/include/minizip-ng

Name: minizip-ng
Description: Zip manipulation library
Version: 4.0.10

Requires.private: zlib
Libs: -L${libdir} -L${sharedlibdir} -lminizip-ng
Libs.private:
Cflags: -I${includedir}
